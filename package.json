{
  "name": "nightlens",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "NightLens - intelligent dark mode for the web (Chrome, Edge, Brave, Opera, Firefox, Safari)",
  "scripts": {
    "build": "node scripts/build.mjs --all",
    "build:chrome": "node scripts/build.mjs --target chrome",
    "build:edge": "node scripts/build.mjs --target edge",
    "build:brave": "node scripts/build.mjs --target brave",
    "build:opera": "node scripts/build.mjs --target opera",
    "build:chromium": "node scripts/build.mjs --target chrome --target edge --target brave --target opera",
    "build:firefox": "node scripts/build.mjs --target firefox",
    "build:safari": "node scripts/build.mjs --target safari",
    "package": "node scripts/package.mjs --all",
    "package:chrome": "node scripts/package.mjs --target chrome",
    "package:edge": "node scripts/package.mjs --target edge",
    "package:brave": "node scripts/package.mjs --target brave",
    "package:opera": "node scripts/package.mjs --target opera",
    "package:firefox": "node scripts/package.mjs --target firefox",
    "package:safari": "node scripts/package.mjs --target safari",
    "safari:project": "node scripts/safari-project.mjs",
    "preview:ui": "node scripts/preview-ui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build:chrome && playwright test",
    "verify:build": "node scripts/verify-build.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run verify:build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "lucide-react": "^1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/chrome": "0.3.6",
    "@types/node": "^22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
