{
  "manifest_version": 3,
  "name": "NightLens",
  "short_name": "NightLens",
  "version": "0.0.0",
  "description": "Premium intelligent dark mode for the web. Privacy-first, highly customizable, and beautifully crafted.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "NightLens",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "commands": {
    "toggle-nightlens": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Turn NightLens on or off"
    }
  }
}
